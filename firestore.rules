rules_version = '2';
// DespensaStock v2: se puede leer, crear y modificar, pero NO borrar.
// La app nueva nunca borra: anula o archiva. Así nadie puede eliminar datos desde afuera.
// Estas reglas se pegan a mano en Firebase Console > Firestore Database > Reglas.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, create, update: if true;
      allow delete: if false;
    }
  }
}
